bility/annotations/1.0" name="depiction" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="depiction"><optional><attribute name="scope"/></optional><optional><attribute name="type"/></optional><zeroOrMore><ref name="image-no-id"/></zeroOrMore></element></define><define name="abbreviation" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="abbreviation"><ref name="LocalizedString"/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="uri" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="uri"><optional><attribute name="type"/></optional><ref name="LocalizedStringAttributes"/><data type="anyURI"/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="contact" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><zeroOrMore><ref name="address"/></zeroOrMore><zeroOrMore><ref name="phone"/></zeroOrMore><zeroOrMore><ref name="email"/></zeroOrMore><zeroOrMore><ref name="uri"/></zeroOrMore></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="phone" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="phone"><optional><attribute name="type"/></optional><text/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="email" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="email"><text/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="address" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="address"><zeroOrMore><ref name="street"/></zeroOrMore><optional><ref name="city"/></optional><optional><ref name="state"/></optional><optional><ref name="country"/></optional><optional><ref name="postcode"/></optional><optional><ref name="formattedAddress"/></optional></element></define><define name="street" datatypeLibrary="http://www.w