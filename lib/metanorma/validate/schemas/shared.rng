ef name="ISO8601Date"/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="locality" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="locality"><ref name="BibItemLocality"/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="localityStack" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="localityStack"><optional><attribute name="connective"><choice><value>and</value><value>or</value><value>from</value><value>to</value><value/></choice></attribute></optional><zeroOrMore><ref name="locality"/></zeroOrMore></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="sourceLocality" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="sourceLocality"><ref name="BibItemLocality"/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="sourceLocalityStack" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="sourceLocalityStack"><optional><attribute name="connective"><choice><value>and</value><value>or</value><value>from</value><value>to</value><value/></choice></attribute></optional><zeroOrMore><ref name="sourceLocality"/></zeroOrMore></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="BibItemLocality" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><attribute name="type"><ref name="LocalityType"/></attribute><optional><ref name="referenceFrom"/></optional><optional><ref name="referenceTo"/></optional></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="LocalityType" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><data type="string"><param name="pattern">section|clause|part|paragraph|chapter|page|title|line|whole|table|annex|figure|note|list|example|volume|issue|time|anchor|locality:[a-zA-Z0-9_]+</param></data></defi