<grammar xmlns="http://relaxng.org/ns/structure/1.0"><start><choice><grammar ns="https://www.metanorma.org/ns/standoc" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="ISO8601DateTime" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><data type="string"><param name="pattern">([\+\-]?\d{4})((-?)((0[1-9]|1[0-2])((-?)([12]\d|0[1-9]|3[01]))?|W([0-4]\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\d|[12]\d{2}|3([0-5]\d|6[1-6])))([T\s]((([01]\d|2[0-3])((:?)[0-5]\d)?|24:?00)([\.,]\d+)?)?((:?)[0-5]\d([.,]\d+)?)?([zZ]|([\+\-])([01]\d|2[0-3]):?([0-5]\d)?)?)?)?</param></data></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="ISO8601Date" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><data type="string"><param name="pattern">([\+\-]?\d{4})((-?)((0[1-9]|1[0-2])((-?)([12]\d|0[1-9]|3[01]))?|W([0-4]\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\d|[12]\d{2}|3([0-5]\d|6[1-6]))))?</param></data></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="status" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="status"><ref name="stage"/><optional><ref name="substage"/></optional><optional><ref name="iteration"/></optional></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="stage" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="stage"><optional><attribute name="abbreviation"/></optional><text/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="substage" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="substage"><optional><attribute name="abbreviation"/></optional><text/></element></define><define name="iteration" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="iteration"><text/></element></define><define name="language" datatypeLibrary="http://