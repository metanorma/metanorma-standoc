="http://www.w3.org/2001/XMLSchema-datatypes"><element name="role"><attribute name="type"><choice><value>author</value><value>performer</value><value>publisher</value><value>editor</value><value>adapter</value><value>translator</value><value>distributor</value><value>realizer</value><value>owner</value><value>authorizer</value><value>enabler</value><value>subject</value></choice></attribute><zeroOrMore><ref name="roledescription"/></zeroOrMore></element></define><define name="ContributorInfo" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><choice><ref name="person"/><ref name="organization"/></choice></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="roledescription" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="description"><ref name="LocalizedMarkedUpString"/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="person" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="person"><optional><ref name="fullname"/></optional><zeroOrMore><ref name="credential"/></zeroOrMore><zeroOrMore><ref name="affiliation"/></zeroOrMore><zeroOrMore><ref name="person-identifier"/></zeroOrMore><optional><ref name="contact"/></optional></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="fullname" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="name"><ref name="FullNameType"/></element></define><define name="credential" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><element name="credential"><text/></element></define><define xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" name="FullNameType" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"><optional><ref name="name_abbreviation"/></optional><group><zeroOrMore><ref name="prefix"/></zeroOrMore><zeroOrMore><ref name="forename"/></zeroOrMore><optional><ref name="formatted-initials"/></optio